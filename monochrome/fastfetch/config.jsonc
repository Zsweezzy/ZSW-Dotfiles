{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/home/maxii/.config/fastfetch/logo.bwzs.txt"
  },
  "modules": [
    "title",
    "separator",
    { "type": "os",             "key": " OS",        "keyColor": "red", "format": "{2}" },
    { "type": "kernel",         "key": " Kernel",    "keyColor": "red" },
    { "type": "packages",       "key": " Packages",  "keyColor": "red" },
    "separator",
    { "type": "de",             "key": " DE",        "keyColor": "red" },
    { "type": "wm",             "key": " WM",        "keyColor": "red" },
    { "type": "wmtheme",        "key": " WM Theme",  "keyColor": "red" },
    { "type": "theme",          "key": " Theme",     "keyColor": "red" },
    { "type": "icons",          "key": " Icons",     "keyColor": "red" },
    { "type": "cursor",         "key": " Cursor",    "keyColor": "red" },
    { "type": "terminal",       "key": " Terminal",  "keyColor": "red" },
    { "type": "terminalfont",   "key": " Terminal Font", "keyColor": "red" },
    "separator",
    { "type": "cpu",            "key": " CPU",       "keyColor": "red" },
    { "type": "gpu",            "key": " GPU",       "keyColor": "red", "format": "{2}" },
    { "type": "memory",         "key": " Memory",    "keyColor": "red", "format": "{1} / {2}" },
    { "type": "display",        "key": " Displays",  "keyColor": "red" },
    { "type": "disk",           "key": " Disk",      "keyColor": "red", "format": "{1} / {2}" },
    { "type": "uptime",         "key": " Uptime",    "keyColor": "red" },
    "break",
    "colors"
  ]
}