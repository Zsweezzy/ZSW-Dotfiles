// Generated by ~/.local/bin/theme from ~/.config/themes/tokyonight/theme.conf.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/home/maxii/.config/fastfetch/logo.tokyonight-moon.txt",
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " ▸ "
  },
  "modules": [
    {
      "type": "title"
    },
    "break",
    {
      "type": "custom",
      "format": "{#dim_blue}┌─────────────────────────────────────────────────────────────┐{#}"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "#82aaff"
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "#82aaff"
    },
    {
      "type": "packages",
      "key": " Packages",
      "keyColor": "#82aaff"
    },
    {
      "type": "host",
      "key": " Host",
      "keyColor": "#82aaff"
    },
    {
      "type": "custom",
      "format": "{#blue}├─────────────────────────────────────────────────────────────┤{#}"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "#bb9af7"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "#bb9af7"
    },
    {
      "type": "wmtheme",
      "key": " WM Theme",
      "keyColor": "#bb9af7"
    },
    {
      "type": "theme",
      "key": " Theme",
      "keyColor": "#bb9af7"
    },
    {
      "type": "icons",
      "key": " Icons",
      "keyColor": "#bb9af7"
    },
    {
      "type": "cursor",
      "key": " Cursor",
      "keyColor": "#bb9af7"
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "#bb9af7"
    },
    {
      "type": "terminalfont",
      "key": " Terminal Font",
      "keyColor": "#bb9af7"
    },
    {
      "type": "custom",
      "format": "{#magenta}├─────────────────────────────────────────────────────────────┤{#}"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "#86e1fc"
    },
    {
      "type": "gpu",
      "key": " GPU",
      "keyColor": "#86e1fc"
    },
    {
      "type": "memory",
      "key": " Memory",
      "keyColor": "#86e1fc",
      "format": "{1} / {2}"
    },
    {
      "type": "swap",
      "key": " Swap",
      "keyColor": "#86e1fc"
    },
    {
      "type": "disk",
      "key": " Disk",
      "keyColor": "#86e1fc",
      "format": "{1} / {2}"
    },
    {
      "type": "battery",
      "key": " Battery",
      "keyColor": "#86e1fc"
    },
    {
      "type": "display",
      "key": " Displays",
      "keyColor": "#86e1fc"
    },
    {
      "type": "custom",
      "format": "{#cyan}├─────────────────────────────────────────────────────────────┤{#}"
    },
    {
      "type": "uptime",
      "key": " Uptime",
      "keyColor": "#f7768e"
    },
    {
      "type": "locale",
      "key": " Locale",
      "keyColor": "#f7768e"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "#f7768e"
    },
    {
      "type": "custom",
      "format": "{#red}└─────────────────────────────────────────────────────────────┘{#}"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 24,
      "symbol": "circle",
      "block": {
        "width": 10
      }
    }
  ]
}