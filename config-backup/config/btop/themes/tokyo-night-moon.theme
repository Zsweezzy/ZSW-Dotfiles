# Theme: tokyo-night-moon
# Based on the "moon" variant of folke/tokyonight.nvim palette

# Main bg
theme[main_bg]="#1e2030"

# Main text color
theme[main_fg]="#c8d3f5"

# Title color for boxes
theme[title]="#c8d3f5"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#86e1fc"

# Background color of selected item in processes box
theme[selected_bg]="#2f334d"

# Foreground color of selected item in processes box
theme[selected_fg]="#c8d3f5"

# Color of inactive/disabled text
theme[inactive_fg]="#414868"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#86e1fc"

# Cpu box outline color
theme[cpu_box]="#414868"

# Memory/disks box outline color
theme[mem_box]="#414868"

# Net up/down box outline color
theme[net_box]="#414868"

# Processes box outline color
theme[proc_box]="#414868"

# Box divider line and small boxes line color
theme[div_line]="#414868"

# Temperature graph colors
theme[temp_start]="#86e1fc"
theme[temp_mid]="#e0af68"
theme[temp_end]="#f7768e"

# CPU graph colors
theme[cpu_start]="#82aaff"
theme[cpu_mid]="#9d7cd8"
theme[cpu_end]="#f7768e"

# Mem/Disk free meter
theme[free_start]="#86e1fc"
theme[free_mid]="#82aaff"
theme[free_end]="#c8d3f5"

# Mem/Disk cached meter
theme[cached_start]="#86e1fc"
theme[cached_mid]="#86e1fc"
theme[cached_end]="#82aaff"

# Mem/Disk available meter
theme[available_start]="#86e1fc"
theme[available_mid]="#86e1fc"
theme[available_end]="#82aaff"

# Mem/Disk used meter
theme[used_start]="#9ece6a"
theme[used_mid]="#e0af68"
theme[used_end]="#f7768e"

# Download graph colors
theme[download_start]="#82aaff"
theme[download_mid]="#86e1fc"
theme[download_end]="#86e1fc"

# Upload graph colors
theme[upload_start]="#bb9af7"
theme[upload_mid]="#9d7cd8"
theme[upload_end]="#82aaff"